# Optional: retained for compatibility; not currently referenced by backend code.
OPENAI_API_KEY=

# Leave empty for local SQLite fallback.
# Production: use the Render PostgreSQL connection URL.
DATABASE_URL=

# Legacy/optional placeholder; backend authentication uses JWT_SECRET_KEY.
SECRET_KEY=

# Required: generate a strong, unique production secret.
JWT_SECRET_KEY=

# Required for AI claim extraction and verification.
GEMINI_API_KEY=

# Comma-separated frontend origins.
# Replace with the actual Vercel domain in Render.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Access token lifetime in minutes (short-lived; default 15).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default 30).
# Must be a stable secret: JWT_SECRET_KEY signs access tokens and
# must NOT change between deploys or all sessions are invalidated.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh cookie settings. SameSite=None is required when the frontend
# and backend are on different sites (e.g. Vercel -> Render); it requires
# Secure cookies, so use "lax"/"strict" only for same-site deployments
# or plain-HTTP local development.
REFRESH_COOKIE_SAMESITE=none
# "true"/"false" override; empty = auto (Secure on HTTPS, plain on HTTP).
REFRESH_COOKIE_SECURE=

# Continuous background monitoring interval in minutes.
# 0 (default) disables the scheduler; set a positive integer to enable
# automatic re-verification of approved claims.
MONITORING_INTERVAL_MINUTES=0

# Rate limit for the public /api/review/analyze endpoint (requests per minute
# per client IP). 0 (default) disables the limiter; set a positive integer to
# enable abuse protection for the guest "instant demo" flow.
ANALYZE_RATE_LIMIT_PER_MINUTE=0
