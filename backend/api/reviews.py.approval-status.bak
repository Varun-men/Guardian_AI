from typing import Literal

from pydantic import BaseModel
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from backend.auth.dependencies import get_db, require_role
from backend.db.models import (
    Draft,
    Review,
    Claim,
    Finding,
    ClaimLedger,
    Fact,
    AuditLog,
    User,
)
from backend.services.audit import record_audit


router = APIRouter(tags=["Reviews"])


# ============================================================
# Reviewer Assignment
# ============================================================

class ReviewerAssignment(BaseModel):
    reviewer_id: str


@router.patch("/api/reviews/{review_id}/assign")
def assign_reviewer(
    review_id: str,
    payload: ReviewerAssignment,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_role("admin")),
):
    try:
        review = db.query(Review).filter(
            Review.id == review_id
        ).first()

        if not review:
            raise HTTPException(status_code=404, detail="Review not found")

        reviewer = db.query(User).filter(
            User.id == payload.reviewer_id
        ).first()

        if not reviewer:
            raise HTTPException(status_code=404, detail="Reviewer not found")

        if not reviewer.is_active:
            raise HTTPException(status_code=400, detail="Reviewer is inactive")

        if reviewer.role != "reviewer":
            raise HTTPException(
                status_code=400,
                detail="User does not have reviewer role"
            )

        old_value = {
            "assigned_reviewer_id": review.assigned_reviewer_id
        }

        review.assigned_reviewer_id = reviewer.id

        record_audit(
            db=db,
            actor_user_id=current_user.id,
            action="review.assigned",
            entity_type="review",
            entity_id=review.id,
            old_value=old_value,
            new_value={"assigned_reviewer_id": reviewer.id}
        )

        db.commit()
        db.refresh(review)

        return {
            "message": "Reviewer assigned successfully",
            "review_id": review.id,
            "reviewer_id": reviewer.id
        }

    except HTTPException:
        db.rollback()
        raise
    except Exception:
        db.rollback()
        raise


# ============================================================
# Claim Decision
# ============================================================

class ClaimDecision(BaseModel):
    decision: Literal["approved", "rejected", "needs_revision"]


@router.patch("/api/reviews/{review_id}/claims/{claim_id}/decision")
def decide_claim(
    review_id: str,
    claim_id: str,
    payload: ClaimDecision,
    db: Session = Depends(get_db),
    current_user: User = Depends(require_role("admin", "reviewer")),
):
    try:
        review = db.query(Review).filter(
            Review.id == review_id
        ).first()

        if not review:
            raise HTTPException(status_code=404, detail="Review not found")

        if current_user.role == "reviewer":
            if review.assigned_reviewer_id != current_user.id:
                raise HTTPException(
                    status_code=403,
                    detail="Review is not assigned to you"
                )

        claim = db.query(Claim).filter(
            Claim.id == claim_id,
            Claim.review_id == review_id
        ).first()

        if not claim:
            raise HTTPException(status_code=404, detail="Claim not found")

        old_value = {"status": claim.status}
        claim.status = payload.decision

        record_audit(
            db=db,
            actor_user_id=current_user.id,
            action="claim.decision",
            entity_type="claim",
            entity_id=claim.id,
            old_value=old_value,
            new_value={"status": payload.decision}
        )

        db.commit()
        db.refresh(claim)

        return {
            "message": "Claim decision recorded successfully",
            "claim_id": claim.id,
            "status": claim.status
        }

    except HTTPException:
        db.rollback()
        raise
    except Exception:
        db.rollback()
        raise


# ============================================================
# Finding Decision
# ============================================================

class FindingDecision(BaseModel):
    decision: str
    content: str | None = None


class ApproveDraftRequest(BaseModel):
    content: str


@router.post("/api/review/findings/{finding_id}/decision")
def decide_finding(
    finding_id: str,
    data: FindingDecision,
    db: Session = Depends(get_db),
    user: User = Depends(require_role("admin", "creator")),
):
    decision = data.decision.lower()

    if decision not in ("applied", "dismissed"):
        raise HTTPException(
            400,
            "Decision must be applied or dismissed"
        )

    if decision == "applied" and data.content is None:
        raise HTTPException(
            400,
            "Updated draft content is required when applying a fix"
        )

    finding = db.query(Finding).filter(
        Finding.id == finding_id
    ).first()

    if not finding:
        raise HTTPException(404, "Finding not found")

    review = db.query(Review).filter(
        Review.id == finding.review_id
    ).first()

    if not review:
        raise HTTPException(404, "Review not found")

    draft = db.query(Draft).filter(
        Draft.id == review.draft_id
    ).first()

    if not draft or draft.status != "in_review":
        raise HTTPException(409, "Draft is not awaiting review")

    try:
        # Save the revised text and audit decision in one transaction.
        if decision == "applied":
            draft.content = data.content

        record_audit(
            db,
            actor_user_id=user.id,
            action=f"finding.{decision}",
            entity_type="finding",
            entity_id=finding.id,
            new_value={"decision": decision},
        )

        db.commit()

        return {
            "finding_id": finding.id,
            "decision": decision,
            "saved": True,
        }

    except Exception:
        db.rollback()
        raise


# ============================================================
# Get Finding Decisions
# ============================================================

@router.get("/api/review/{draft_id}/decisions")
def get_decisions(
    draft_id: str,
    db: Session = Depends(get_db),
    user: User = Depends(require_role("admin", "creator")),
):
    draft = db.query(Draft).filter(
        Draft.id == draft_id
    ).first()

    if not draft:
        raise HTTPException(404, "Draft not found")

    review = db.query(Review).filter(
        Review.draft_id == draft_id
    ).order_by(Review.created_at.desc()).first()

    if not review:
        raise HTTPException(404, "Review not found")

    result = {}

    for finding in review.findings:
        audit = db.query(AuditLog).filter(
            AuditLog.entity_type == "finding",
            AuditLog.entity_id == finding.id,
            AuditLog.action.in_([
                "finding.applied",
                "finding.dismissed",
            ]),
        ).order_by(AuditLog.id.desc()).first()

        result[finding.id] = (
            audit.new_value.get("decision")
            if audit and audit.new_value
            else None
        )

    return {
        "draft_id": draft_id,
        "content": draft.content,
        "decisions": result,
    }


# ============================================================
# Approve Draft
# ============================================================

@router.post("/api/review/{draft_id}/approve")
def approve_draft(
    draft_id: str,
    data: ApproveDraftRequest,
    db: Session = Depends(get_db),
    user: User = Depends(require_role("admin", "creator")),
):
    draft = db.query(Draft).filter(
        Draft.id == draft_id
    ).first()

    if not draft:
        raise HTTPException(404, "Draft not found")

    if draft.status != "in_review":
        raise HTTPException(409, "Draft is not awaiting approval")

    review = db.query(Review).filter(
        Review.draft_id == draft_id
    ).order_by(Review.created_at.desc()).first()

    if not review:
        raise HTTPException(404, "Review not found")

    for finding in review.findings:
        if finding.severity == "SUPPORTED":
            continue

        audit = db.query(AuditLog).filter(
            AuditLog.entity_type == "finding",
            AuditLog.entity_id == finding.id,
            AuditLog.action.in_([
                "finding.applied",
                "finding.dismissed",
            ]),
        ).order_by(AuditLog.id.desc()).first()

        if not audit:
            raise HTTPException(
                409,
                f"Finding {finding.id} still needs a decision",
            )

    try:
        draft.content = data.content
        draft.status = "approved"
        review.status = "approved"

        # Create ledger entries only when a valid fact association exists.
        for finding in review.findings:
            for item in finding.evidence or []:
                fact_id = item.get("fact_id")

                if not finding.claim_id or not fact_id:
                    continue

                fact = db.query(Fact).filter(
                    Fact.id == fact_id
                ).first()

                if not fact:
                    continue

                existing = db.query(ClaimLedger).filter(
                    ClaimLedger.claim_id == finding.claim_id,
                    ClaimLedger.fact_id == fact.id,
                ).first()

                if not existing:
                    db.add(ClaimLedger(
                        claim_id=finding.claim_id,
                        fact_id=fact.id,
                        status="approved",
                    ))

        record_audit(
            db,
            actor_user_id=user.id,
            action="draft.approved",
            entity_type="draft",
            entity_id=draft.id,
            new_value={"status": "approved"},
        )

        db.commit()

        return {
            "draft_id": draft.id,
            "status": "approved",
            "review_id": review.id,
        }

    except Exception:
        db.rollback()
        raise
